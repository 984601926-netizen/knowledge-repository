{
  "name": "zhishi-local",
  "version": "1.1.1",
  "private": true,
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "description": "拾知 · 离线个人知识库",
  "author": "拾知",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "local.shizhi.knowledge",
    "productName": "拾知",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Shizhi-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "fflate": "0.8.3",
    "lucide-react": "1.70.0",
    "marked": "18.1.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "sql.js": "1.15.2",
    "turndown": "7.2.5",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
